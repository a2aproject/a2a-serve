// C. a2a-serve on Agent Mesh, for access-model.md and the README.
// Top to bottom: callers, the Agent Mesh
// relay, a2a-serve with the embedded meshnet node, the sandboxed harness.
// Agents on the mesh call in through the relay, and the harness calls them
// back out through the server and the same node.
// Render: dot -Tpng -Gdpi=110 readme-agentmesh.dot -o readme-agentmesh.png
digraph readme_agentmesh {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=14, nodesep=0.4, ranksep=0.5, pad=0.3, newrank=true];
  node  [fontname="Helvetica", fontsize=13, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#555555"];
  edge  [fontname="Helvetica", fontsize=11, color="#555555", fontcolor="#333333"];

  subgraph cluster_callers {
    label="Callers"; style="rounded,filled"; fillcolor="#eef5ff"; color="#9bb7e0";
    { rank=same;
      Internet  [label="Anyone on the internet\na2a CLI, A2A clients", shape=ellipse, fillcolor="#dbe8ff"];
      Mesh      [label="Agents on the mesh\nyours and your team's,\nbehind NAT", shape=ellipse, fillcolor="#dbe8ff"];
      Messenger [label="Messengers\nTelegram, Discord, email", shape=ellipse, fillcolor="#dbe8ff"];
    }
  }

  subgraph cluster_relay {
    label="Agent Mesh relay (agentmesh-one)"; labeljust=l; style="rounded,filled"; fillcolor="#fdf1e6"; color="#e0b48a";
    { rank=same;
      Ingress [label="Public ingress\n/ingress/<peer>/a2a/<name>"];
      Routing [label="Relay\nconnects nodes, verifies\nmesh identities"];
      Control [label="Control plane\nsign-in, join tokens,\nBiscuits, policy"];
    }
  }

  subgraph cluster_server {
    label="a2a-serve"; labeljust=l; style="rounded,filled"; fillcolor="#f0f9f0"; color="#9ccc9c";
    { rank=same;
      MeshNode     [label="meshnet node, in process\nnode key, WhoIs,\nA2A listener and dialer", fillcolor="#fdf1e6", color="#e0b48a"];
      Channels [label="Channels"];
    }
    { rank=same;
      Core  [label="A2A server\npolicy, pairing,\ntasks, approvals"];
      Proxy [label="Peers proxy\nholds credentials; reaches\nagents outside the mesh\nover HTTPS"];
    }
  }

  subgraph cluster_sandbox {
    label="Docker sandbox"; labeljust=l; style="rounded,filled"; fillcolor="#f3eefb"; color="#b9a4dd";
    { rank=same;
      Harness [label="Coding agent\nopencode, Claude Code, ACP"];
      CLI     [label="a2a CLI"];
    }
  }


  Internet -> Ingress [label="1. public URL"];
  Mesh -> Routing [dir=both, label="2. agent to agent,\nboth ways, with\nmesh identity"];
  Messenger -> Channels;
  Ingress -> MeshNode [label="pairing token or\nGoogle sign-in"];
  Routing -> MeshNode [dir=both, label="verified caller"];
  Control -> MeshNode [style=dashed, label="enrollment"];
  MeshNode -> Core [label="identity → role"];
  Channels -> Core;
  Core -> Harness [label="ACP"];
  Harness -> CLI [label="a2a send"];
  Proxy -> CLI [dir=back];
  MeshNode -> Proxy [dir=back, label="3. calls to agents\non the mesh"];
}
