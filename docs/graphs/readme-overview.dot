// README overview: a simplified agent-server-overview.dot. Top to bottom:
// callers, the server, the sandboxed agent; the agent calls other agents
// back through the server.
// Render: docs/graphs/render.sh readme-overview.dot
digraph readme_overview {
  rankdir=TB;
  graph [fontname="Helvetica", nodesep=0.4, ranksep=0.45, pad=0.3, newrank=true];
  node  [fontname="Helvetica", fontsize=13, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#555555"];
  edge  [fontname="Helvetica", fontsize=11, color="#555555", fontcolor="#333333"];

  { rank=same;
    Client   [label="A2A clients", shape=ellipse, fillcolor="#dbe8ff"];
    Telegram [label="Telegram", shape=ellipse, fillcolor="#dbe8ff"];
    Discord  [label="Discord", shape=ellipse, fillcolor="#dbe8ff"];
    Email    [label="Email", shape=ellipse, fillcolor="#dbe8ff"];
  }

  subgraph cluster_server {
    label="a2a-serve"; labeljust=l; style="rounded,filled"; fillcolor="#f0f9f0"; color="#9ccc9c";
    // Pad keeps the incoming edges clear of the cluster label.
    { rank=same; Pad [label="", style=invis, width=0.6]; Net [label="Listeners"]; Messengers [label="Messengers"]; }
    { rank=same; Core [label="A2A server"]; Proxy [label="Agents proxy"]; }
  }

  Agent [fillcolor="#f3eefb", color="#b9a4dd", margin="0.15,0.08", label=<
    <table border="0" cellspacing="0" cellpadding="2">
      <tr><td align="left">Sandbox</td></tr>
      <tr><td cellpadding="6">Agent<br/>(opencode, Claude Code, ACP)</td></tr>
    </table>>];

  { rank=same;
    Remote  [label="Other agents", shape=ellipse, fillcolor="#e3f4e3"];
    Webhook [label="Webhook nodes", shape=ellipse, fillcolor="#e3f4e3"];
  }

  Client -> Net;
  Telegram -> Messengers;
  Discord -> Messengers;
  Email -> Messengers;
  Net -> Core;
  Pad -> Core [style=invis];
  Messengers -> Core [tailport=s];
  Core -> Agent [label=" ACP"];
  Agent -> Proxy [label=" a2a CLI"];
  Proxy -> Remote;
  Proxy -> Webhook;
}
